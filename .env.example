# Supabase Auth — copy this file to `.env.local` and fill in your project values.
# When BOTH are set, the app uses real Supabase auth (login, forgot/reset password,
# email verification, session persistence). When either is missing, it transparently
# falls back to the mock/localStorage auth + demo accounts.

# Placeholders only — this file is committed. Never put real keys here.
# Find these under Supabase dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — bypasses Row Level Security. Never expose to the browser
# and never commit the real value. See SUPABASE_AUTH_SETUP.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

VITE_DATA_BACKEND=supabase